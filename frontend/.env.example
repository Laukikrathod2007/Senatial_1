# SENTINEL frontend configuration.
#
#   cp .env.example .env
#
# Vite inlines VITE_* variables into the bundle at BUILD time -- they are not
# read at runtime. Two consequences:
#
#   1. Changing this requires a rebuild, not just a restart.
#   2. Anything here ships to the browser in plain text. Never put a secret in
#      this file. There is nothing secret to put here: the frontend holds no
#      credentials, and the auditor token is obtained at sign-in and kept in
#      memory only (never localStorage, which any injected script can read).

# Where the SENTINEL API is reachable FROM THE BROWSER.
#
# This is a host-visible URL, not a container hostname: under Docker Compose the
# browser talks to the published port on the host, so "http://backend:8000"
# would not resolve. Compose passes this as a build arg instead.
VITE_API_URL=http://127.0.0.1:8000
