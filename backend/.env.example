# SENTINEL backend configuration.
#
# Copy to `.env` and edit. Every value below has a working default in
# src/sentinel/config.py, so the project runs with no .env at all -- this file
# exists to document what is configurable and which value is genuinely unsafe
# to leave alone.
#
#   cp .env.example .env
#
# There are NO external API keys, third-party accounts, or remote connection
# strings anywhere in this project. Nothing here is a credential for someone
# else's service.


# -- The one secret that matters ---------------------------------------------
#
# Signs the JWTs that carry an auditor's role. The default in config.py is a
# KNOWN, PUBLIC placeholder: anyone holding it can mint a gov_self_audit token
# with the largest query allowance and privacy ceiling in the system.
#
# Override this in any deployment reachable by anyone but you. Generate one with:
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Use at least 32 bytes -- HS256 with a shorter key weakens the signature
# (RFC 7518 section 3.2) and PyJWT will warn.
SENTINEL_JWT_SECRET=replace-me-with-32-random-bytes-see-comment-above

# Session lifetime in seconds. Short by design: a token grants real query budget
# against a real system.
SENTINEL_JWT_TTL_SECONDS=3600


# -- Storage ------------------------------------------------------------------
#
# Any SQLAlchemy URL. SQLite is the default and is sufficient: append-only is
# enforced by the hash chain and service layer, not by the database engine.
# Postgres example:
#   SENTINEL_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel
# SENTINEL_DATABASE_URL=sqlite:///./var/sentinel.db

# Runtime state root: SQLite ledger, Ed25519 keys, cached models.
# SENTINEL_VAR_DIR=./var


# -- Differential privacy (M5) ------------------------------------------------
#
# delta in (epsilon, delta)-DP. Kept well below 1/n for the dataset audited.
# SENTINEL_DP_DELTA=1e-5

# Noise multiplier (sigma) for the Gaussian mechanism in query accounting.
# Chosen by working backwards from the audit sizes the roles permit: at sigma=1
# a 100-query audit already costs eps~96, which is not a privacy guarantee in
# any meaningful sense and would deny every audit the tool exists to run.
# Lower = stricter accounting, budgets exhaust sooner.
# SENTINEL_DP_NOISE_MULTIPLIER=40.0


# -- Membership inference (M1) ------------------------------------------------
#
# Shadow models used to calibrate the null distribution. More shadows tighten
# the bootstrap interval but cost training time (16 takes ~11s, cached after).
# SENTINEL_SHADOW_COUNT=16

# Records per shadow model. Should stay close to the target's training size so
# the null answers "what would a model like this one do".
# SENTINEL_SHADOW_TRAIN_SIZE=4000


# -- Not configured here ------------------------------------------------------
#
# The Ed25519 signing keypair is NOT an environment variable. It is generated on
# first run into var/keys/:
#
#   ed25519_private.pem   never committed; signs reports
#   ed25519_public.pem    committed on purpose; verification needs a key the
#                         reader already holds, or a compromised server could
#                         serve a key matching forged reports
#
# Never rotate the private key against a live ledger: every previously sealed
# report would fail verification, which is indistinguishable from tampering.
